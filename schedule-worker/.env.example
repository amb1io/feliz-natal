# Non-secret vars (configure in wrangler.toml [vars] / [env.<name>.vars])
SITE_URL=https://feliz.natal.br
AWS_REGION=sa-east-1
SES_FROM_EMAIL=no-reply@feliz.natal.br
SES_FROM_NAME=Feliz Natal
WHATSAPP_API_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DRAW_TEMPLATE_NAME=
WHATSAPP_DRAW_TEMPLATE_LANG=pt_BR
WHATSAPP_DRAW_TEMPLATE_COMPONENTS=body
WHATSAPP_DRAW_INCLUDE_HEADER=false
WHATSAPP_DRAW_INCLUDE_BUTTON=false
WHATSAPP_SITE_BASE_URL=https://feliz.natal.br
WHATSAPP_HEADER_IMAGE_URL=https://feliz.natal.br/og-image-whatsapp.jpg
WHATSAPP_DEFAULT_COUNTRY_CODE=55

# Secrets (upload with upload-dev-secrets.sh -> wrangler secret put)
AWS_SES_ACCESS_KEY_ID=your_aws_ses_access_key_id
AWS_SES_SECRET_ACCESS_KEY=your_aws_ses_secret_access_key
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_access_token
# Optional when using temporary AWS credentials
AWS_SESSION_TOKEN=
