{
  "name": "deeply-dwarf",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --port 8788",
    "dev-build": "astro build && npm run db:migrate:local:dev-build && wrangler dev --config dist/server/wrangler.json --port 8788 --persist-to .wrangler/state",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prisma": "prisma",
    "wrangler": "wrangler",
    "migrations:copy": "node scripts/copy-prisma-migrations.mjs",
    "db:migrate:local": "wrangler d1 migrations apply feliz-natal --local",
    "db:migrate:local:dev-build": "wrangler d1 migrations apply feliz-natal --local --persist-to .wrangler/state",
    "db:shell:local": "wrangler d1 execute feliz-natal --local --command"
  },
  "dependencies": {
    "@astrojs/alpinejs": "^0.5.0",
    "@astrojs/cloudflare": "^13.5.2",
    "@astrojs/sitemap": "^3.7.2",
    "@prisma/client": "^6.18.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/alpinejs": "^3.13.11",
    "alpinejs": "^3.15.1",
    "astro": "^6.3.4",
    "astro-htmx": "^1.0.6",
    "aws4fetch": "^1.0.20",
    "dotenv": "^17.2.3",
    "htmx.org": "^2.0.8",
    "linkedom": "^0.18.12",
    "prisma": "^6.18.0",
    "tailwindcss": "^4.1.16",
    "verlet": "^1.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260518.1",
    "wrangler": "^4.92.0"
  }
}
