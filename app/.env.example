# -----------------------------------------------------------------------------
# Astro Frontend Configuration
# -----------------------------------------------------------------------------
# Custom domain (produção): login.feliz.natal.br
# Domínio padrão Cognito (só dev legado): feliz-natal-user-pool-000000000000.auth.sa-east-1.amazoncognito.com
PUBLIC_COGNITO_DOMAIN=login.feliz.natal.br
PUBLIC_COGNITO_CLIENT_ID=your_cognito_client_id

# PUBLIC_COGNITO_REDIRECT_URI=http://localhost:4321/auth/callback
# PUBLIC_COGNITO_LOGOUT_URI=http://localhost:4321

PUBLIC_COGNITO_REDIRECT_URI=http://localhost:8788/auth/callback
PUBLIC_COGNITO_LOGOUT_URI=http://localhost:8788/
PUBLIC_COGNITO_REGION=sa-east-1
# Optional: comma-separated list of providers to show
PUBLIC_COGNITO_SUPPORTED_PROVIDERS=Google,Microsoft,Slack,GitHub,Facebook

# -----------------------------------------------------------------------------
# AWS Infrastructure Deployment (used by deploy.sh)
# -----------------------------------------------------------------------------
AWS_REGION=sa-east-1
AWS_ACCOUNT_ID=000000000000

# Cognito Configuration
USER_POOL_NAME=feliz-natal-user-pool
CALLBACK_URLS=http://localhost:4321/auth/callback,http://localhost:8788/auth/callback,https://your-domain.example/auth/callback
LOGOUT_URLS=http://localhost:4321/,http://localhost:8788/,https://your-domain.example/

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
PUBLIC_GOOGLE_MAPS_KEY=your_public_google_maps_key

# Microsoft OAuth Configuration
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
# MICROSOFT_CLIENT_SECRET=optional_previous_secret
MICROSOFT_TENANT_ID=common

# Slack OAuth Configuration
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret

# Facebook Login OAuth Configuration (Cognito Social Login)
# Use o App ID/Secret do app Meta criado especificamente para login de usuarios.
FACEBOOK_LOGIN_APP_ID=your_facebook_login_app_id
FACEBOOK_LOGIN_APP_SECRET=your_facebook_login_app_secret

# This was inserted by `prisma init`:
# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma connection string (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

WEBSOCKET_WORKER_URL=http://localhost:8788/api/ws/grupo
AVATAR_PUBLIC_BASE_URL=https://cdn.your-domain.example

# -----------------------------------------------------------------------------
# Meta WhatsApp Cloud API (webhooks)
# -----------------------------------------------------------------------------
# Token definido no painel Meta ao configurar o webhook (deve ser idêntico aqui).
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token
# App Secret do app Meta (Configurações básicas > Chave secreta do app).
META_APP_SECRET=your_meta_app_secret
# Token de acesso (System User ou token do app com whatsapp_business_messaging).
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
# ID do número de telefone (WhatsApp > API Setup).
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
# Nome exato do template aprovado no Meta Business Manager.
WHATSAPP_INVITE_TEMPLATE_NAME=feliz_natal_grupo_criado
WHATSAPP_INVITE_TEMPLATE_LANG=pt_BR
WHATSAPP_API_VERSION=v25.0
# Produção (feliz_natal_grupo_criado): header_body + true
# Teste Meta (3p_direct_integration_test_template): none + en_US
WHATSAPP_INVITE_TEMPLATE_COMPONENTS=header_body
WHATSAPP_INVITE_USE_NAMED_PARAMETERS=true
WHATSAPP_INVITE_INCLUDE_HEADER=false
WHATSAPP_INVITE_INCLUDE_BUTTON=false
WHATSAPP_SITE_BASE_URL=https://your-domain.example
# JPEG 8-bit (Meta rejeita og-image.png 16-bit). Gere com: sips -s format jpeg og-image.png --out og-image-whatsapp.jpg
WHATSAPP_HEADER_IMAGE_URL=https://your-domain.example/og-image-whatsapp.jpg
WHATSAPP_DEFAULT_COUNTRY_CODE=55
WHATSAPP_SECRET_MESSAGE_TEMPLATE_NAME=feliz_natal_mensagem_secreta
WHATSAPP_SECRET_MESSAGE_TEMPLATE_LANG=pt_BR
WHATSAPP_SECRET_MESSAGE_TEMPLATE_COMPONENTS=body_button
WHATSAPP_SECRET_MESSAGE_USE_NAMED_PARAMETERS=false
WHATSAPP_SECRET_MESSAGE_INCLUDE_HEADER=false
WHATSAPP_SECRET_MESSAGE_INCLUDE_BUTTON=true
WHATSAPP_DRAW_TEMPLATE_NAME=feliz_natal_sorteio_concluido
WHATSAPP_DRAW_TEMPLATE_LANG=pt_BR
WHATSAPP_DRAW_TEMPLATE_COMPONENTS=body_button
WHATSAPP_DRAW_USE_NAMED_PARAMETERS=false
WHATSAPP_DRAW_INCLUDE_HEADER=false
WHATSAPP_DRAW_INCLUDE_BUTTON=true

# SES Email Configuration
AWS_SES_ACCESS_KEY_ID=your_aws_ses_access_key_id
AWS_SES_SECRET_ACCESS_KEY=your_aws_ses_secret_access_key
SES_FROM_EMAIL=no-reply@your-domain.example
SES_FROM_NAME=Feliz Natal
AWS_SESSION_TOKEN=

# Telegram ops alerts (BotFather token + seu @username; envie /start ao bot uma vez)
botfather_token=your_telegram_bot_token
my_telegram=your_telegram_username
