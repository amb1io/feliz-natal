---
interface Props {
	title?: string;
	shadow?: boolean;
}

const { title, shadow = true } = Astro.props;
const shadowClass = shadow ? 'shadow-[0_12px_24px_rgba(109,76,65,0.1)]' : '';
---

<section class={`space-y-4 bg-[var(--color-surface)] px-6 py-6 ${shadowClass}`}>
	{title && (
		<h2 class="text-sm font-semibold uppercase tracking-[0.3em] text-[var(--color-text-muted)]">
			{title}
		</h2>
	)}
	<slot />
</section>
