---
const options = [
	{
		value: 'ladrao',
		label: 'Amigo Ladrão',
		description: 'Roube o presente do amigo ao final.',
		icon: '🎁'
	},
	{
		value: 'onca',
		label: 'Amigo da Onça',
		description: 'Brincadeira descontraída com presentes engraçados.',
		icon: '🃏'
	},
	{
		value: 'tradicional',
		label: 'Amigo Tradicional',
		description: 'Sorteio clássico sem trocas no momento da revelação.',
		icon: '🎄'
	}
];
---

<div class="grid gap-3 sm:grid-cols-3">
	{
		options.map((option) => (
			<label
				class="cursor-pointer rounded-2xl border border-[rgba(148,163,184,0.2)] bg-[var(--color-surface)] p-3 text-sm text-[var(--color-text)] shadow-[0_8px_18px_rgba(15,23,42,0.08)] transition hover:-translate-y-0.5 hover:border-[var(--color-primary)]"
				:class={`form.giftType === '${option.value}' ? 'border-[var(--color-primary)] shadow-[0_12px_24px_rgba(230,57,70,0.18)]' : ''`}
			>
				<input
					type="radio"
					name="tipo_presente"
					value={option.value}
					x-model="form.giftType"
					class="sr-only"
					required={option.value === 'ladrao'}
				/>
				<div class="space-y-3">
					<div class="flex h-24 items-center justify-center rounded-xl bg-[rgba(255,209,102,0.22)] text-4xl">
						<span aria-hidden="true">{option.icon}</span>
					</div>
					<div class="space-y-1">
						<p class="text-base font-semibold text-[var(--color-text)]">{option.label}</p>
						<p class="text-xs leading-relaxed text-[var(--color-text-muted)]">{option.description}</p>
					</div>
				</div>
			</label>
		))
	}
</div>
