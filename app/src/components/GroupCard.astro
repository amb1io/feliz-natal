---
interface Props {
  slug: string;
  titulo: string;
  descricao?: string | null;
  status: string;
  criado_em?: string | null;
}

const { slug, titulo, descricao, status, criado_em } = Astro.props;

const formatDate = (value?: string | null) =>
  value
    ? new Date(value).toLocaleDateString("pt-BR", {
        day: "2-digit",
        month: "short",
        year: "numeric",
      })
    : "Data desconhecida";
---

<a
  href={`/app/grupo/${slug}`}
  aria-label={`Abrir grupo ${titulo}`}
  class="group flex h-full flex-col justify-between rounded-3xl border border-[var(--color-border)] bg-[var(--color-surface)] px-6 py-6 text-left shadow-[0_12px_24px_rgba(109,76,65,0.12)] transition duration-200 hover:-translate-y-0.5 hover:border-[var(--color-primary)] hover:shadow-[0_16px_30px_rgba(109,76,65,0.2)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-primary)]"
>
  <header class="space-y-1">
    <h2
      class="text-lg font-semibold text-[var(--color-text)] transition-colors group-hover:text-[var(--color-primary)]"
    >
      {titulo}
    </h2>
    <span
      class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.25em] text-[var(--color-text-muted)]"
    >
      Status:{" "}
      <span class="font-semibold text-[var(--color-primary)]">{status}</span>
    </span>
  </header>
  {
    descricao && (
      <p class="mt-4 text-sm text-[var(--color-text-muted)]">{descricao}</p>
    )
  }
  <footer
    class="mt-6 flex items-center justify-between text-xs text-[var(--color-text-muted)]"
  >
    <span>Criado em {formatDate(criado_em)}</span>
    <span
      class="inline-flex items-center gap-1 font-semibold text-[var(--color-primary)] group-hover:underline"
    >
      Detalhes
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="h-4 w-4"
      >
        <path
          fill-rule="evenodd"
          d="M3 10a.75.75 0 0 1 .75-.75h9.19l-2.47-2.47a.75.75 0 0 1 1.06-1.06l3.75 3.75a.75.75 0 0 1 0 1.06l-3.75 3.75a.75.75 0 1 1-1.06-1.06l2.47-2.47H3.75A.75.75 0 0 1 3 10Z"
          clip-rule="evenodd"></path>
      </svg>
    </span>
  </footer>
</a>
